# ==============================================================================
# ENVIRONMENT CONFIGURATION EXAMPLE
# ==============================================================================
# Copy this file to '.env' in the same directory and fill in your private API keys.
# DO NOT commit your actual '.env' file to Git or public repositories.
# ==============================================================================

# --- Movie / Media APIs ---
# TMDB API Key or Read Access Token (v3 Key is 32 chars, v4 Token starts with 'eyJ...')
TMDB_API_KEY=YOUR_TMDB_API_KEY_HERE

# --- Additional Project Keys ---
# Add key-value pairs for other experimental scripts below:
# OPENAI_API_KEY=YOUR_OPENAI_KEY_HERE
# SPOTIFY_CLIENT_SECRET=YOUR_SPOTIFY_SECRET_HERE